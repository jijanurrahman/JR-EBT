{
  "expo": {
    "name": "JR-EBT",
    "slug": "JR-EBT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jr-ebt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow JR-EBT to use Face ID to protect your financial data."
      }
    },
    "android": {
      "package": "com.jijanurrahman.jrebt",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow JR-EBT to use Face ID to protect your financial data."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8242836-a225-4174-8e50-990feb624b3a"
      }
    }
  }
}
